<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains project properties used by the build. -->
<Project>

  <!-- Plugin Metadata -->
  <PropertyGroup>
    <PluginId>FCSplash</PluginId>
    <PluginName>FCSplash</PluginName>
    <Authors>zjavierf</Authors>
    <Version>0.3.0</Version>
    <GameVersion>1.40.8</GameVersion>
    <Description>Shows a splash animation when you FC</Description>
    <!--<PluginIcon></PluginIcon>-->
    <!--<ProjectSource>https://github.com/unknownjwly/BS_FCSplash</ProjectSource>-->
    <!--<ProjectHome></ProjectHome>-->
    <!--<DonateUrl></DonateUrl>-->
  </PropertyGroup>

  <!-- Plugin Dependencies -->
  <ItemGroup>
    <DependsOn Include="BSIPA" Version="^4.3.0"/>
    <DependsOn Include="SiraUtil" Version="^3.1.0"/>
  </ItemGroup>
  
  <PropertyGroup>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GenerateManifest>true</GenerateManifest>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DisableZipRelease>true</DisableZipRelease>
  </PropertyGroup>
  
</Project>
